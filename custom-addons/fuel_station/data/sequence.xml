<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="0">
  
    <record id="seq_fuel_delivery" model="ir.sequence">
      <field name="name">Fuel Delivery</field>
      <field name="code">fuel.delivery</field>
      <field name="prefix">FD/%(year)s/</field>
      <field name="padding">4</field>
    </record>

    <record id="seq_fuel_credit_sale" model="ir.sequence">
      <field name="name">Fuel Credit Sale</field>
      <field name="code">fuel.credit.sale</field>
      <field name="prefix">CS/%(year)s/</field>
      <field name="padding">5</field>
    </record>

    <record id="seq_fuel_cash_deposit" model="ir.sequence">
      <field name="name">Fuel Cash Deposit</field>
      <field name="code">fuel.cash.deposit</field>
      <field name="prefix">CD/%(year)s/</field>
      <field name="padding">5</field>
    </record>

    <record id="seq_fuel_credit_payment" model="ir.sequence">
      <field name="name">Fuel Credit Payment</field>
      <field name="code">fuel.credit.payment</field>
      <field name="prefix">CP/%(year)s/</field>
      <field name="padding">5</field>
    </record>

    <record id="seq_fuel_attendant_session" model="ir.sequence">
      <field name="name">Fuel Attendant Session</field>
      <field name="code">fuel.attendant.session</field>
      <field name="prefix">AS/%(year)s/</field>
      <field name="padding">5</field>
    </record>

    <record id="seq_fuel_station_shift_close" model="ir.sequence">
      <field name="name">Station Shift Close</field>
      <field name="code">fuel.station.shift.close</field>
      <field name="prefix">SC/%(year)s/</field>
      <field name="padding">5</field>
    </record>


    <record id="seq_fuel_petty_cash_expense" model="ir.sequence">
      <field name="name">Cash Expense</field>
      <field name="code">fuel.petty.cash.expense</field>
      <field name="prefix">PCE/%(year)s/</field>
      <field name="padding">5</field>
    </record>

    <record id="seq_fuel_petty_cash_expense_bill" model="ir.sequence">
      <field name="name">Cash Expense Bill No.</field>
      <field name="code">fuel.petty.cash.expense.bill</field>
      <field name="prefix">BN/%(year)s/</field>
      <field name="padding">5</field>
    </record>

    <record id="seq_fuel_petty_cash_replenishment" model="ir.sequence">
      <field name="name">Petty Cash Deposit</field>
      <field name="code">fuel.petty.cash.replenishment</field>
      <field name="prefix">PCR/%(year)s/</field>
      <field name="padding">5</field>
    </record>

    <record id="seq_fuel_payout" model="ir.sequence">
      <field name="name">Payout</field>
      <field name="code">fuel.payout</field>
      <field name="prefix">PO/%(year)s/</field>
      <field name="padding">5</field>
    </record>

  </data>
</odoo>