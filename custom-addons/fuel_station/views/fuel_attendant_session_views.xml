<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_fuel_attendant_session_tree" model="ir.ui.view">
      <field name="name">fuel.attendant.session.tree</field>
      <field name="model">fuel.attendant.session</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="date"/>
          <field name="shift_id"/>
          <field name="attendant_id"/>
          <field name="state"/>
          <field name="total_sales"/>
          <field name="total_credit_sales"/>
          <field name="expected_cash"/>
          <field name="total_cash_deposited"/>
          <field name="cash_difference"/>
        </tree>
      </field>
    </record>

    <record id="view_fuel_attendant_session_form" model="ir.ui.view">
      <field name="name">fuel.attendant.session.form</field>
      <field name="model">fuel.attendant.session</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_populate_shift_transactions" type="object" string="Pull Shift Transactions" class="oe_highlight" invisible="state != 'draft'"/>
            <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
          </header>

          <sheet>
            <group>
              <field name="name" readonly="1"/>
              <field name="date"/>
              <field name="shift_id"/>
              <field name="attendant_id"/>
            </group>

            <notebook>
              <page string="Sales">
                <field name="line_ids">
                  <tree editable="bottom">
                    <field name="pump_id"/>
                    <field name="product_id" readonly="1"/>
                    <field name="previous_meter" readonly="1"/>
                    <field name="current_meter"/>
                    <field name="litres_sold" readonly="1"/>
                    <field name="price"/>
                    <field name="total" readonly="1"/>
                  </tree>
                </field>
                <group>
                  <field name="total_sales" readonly="1"/>
                </group>
              </page>

              <page string="Credit Sales">
                <field name="credit_sale_ids">
                  <tree>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="invoice_ref"/>
                    <field name="pump_id"/>
                    <field name="customer_id"/>
                    <field name="vehicle_plate"/>
                    <field name="litres"/>
                    <field name="price"/>
                    <field name="amount"/>
                  </tree>
                </field>
                <group>
                  <field name="total_credit_sales" readonly="1"/>
                </group>
              </page>

              <page string="Cash">
                <field name="cash_deposit_ids">
                  <tree>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="amount"/>
                    <field name="received_by_id"/>
                  </tree>
                </field>
                <group>
                  <field name="expected_cash" readonly="1"/>
                  <field name="total_cash_deposited" readonly="1"/>
                  <field name="cash_difference" readonly="1"/>
                </group>
              </page>
            </notebook>

          </sheet>
        </form>
      </field>
    </record>

    <record id="action_fuel_attendant_sessions" model="ir.actions.act_window">
      <field name="name">Attendant Sessions</field>
      <field name="res_model">fuel.attendant.session</field>
      <field name="view_mode">tree,form</field>
    </record>

  </data>
</odoo>