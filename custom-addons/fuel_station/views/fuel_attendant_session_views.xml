<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- ================================================================
         List View
    ================================================================ -->
    <record id="view_fuel_attendant_session_tree" model="ir.ui.view">
      <field name="name">fuel.attendant.session.tree</field>
      <field name="model">fuel.attendant.session</field>
      <field name="arch" type="xml">
        <list decoration-muted="state == 'draft'"
              decoration-success="state == 'approved'">
          <field name="name"/>
          <field name="date"/>
          <field name="shift_id"/>
          <field name="attendant_id"/>
          <field name="currency_id" column_invisible="1"/>
          <field name="total_sales" widget="monetary"/>
          <field name="total_credit_sales" widget="monetary" optional="show"/>
          <field name="expected_cash" widget="monetary" optional="show"/>
          <field name="total_cash_deposited" widget="monetary" optional="show"/>
          <field name="cash_difference" widget="monetary" optional="hide"/>
          <field name="state" widget="badge"
                 decoration-success="state == 'approved'"/>
        </list>
      </field>
    </record>

    <!-- ================================================================
         Kanban View
    ================================================================ -->
    <record id="view_fuel_attendant_session_kanban" model="ir.ui.view">
      <field name="name">fuel.attendant.session.kanban</field>
      <field name="model">fuel.attendant.session</field>
      <field name="arch" type="xml">
        <kanban default_group_by="shift_id" class="o_kanban_small_column"
                quick_create="false">
          <field name="name"/>
          <field name="attendant_id"/>
          <field name="date"/>
          <field name="total_sales"/>
          <field name="currency_id"/>
          <field name="state"/>
          <field name="credit_sale_count"/>
          <field name="cash_deposit_count"/>
          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click">
                <div class="oe_kanban_content p-3">
                  <div class="o_kanban_record_top mb-2">
                    <div class="o_kanban_record_headings">
                      <strong class="o_kanban_record_title fs-6">
                        <t t-esc="record.name.value"/>
                      </strong>
                    </div>
                    <span t-attf-class="badge rounded-pill #{record.state.raw_value == 'approved' ? 'text-bg-success' : 'text-bg-secondary'}">
                      <field name="state"/>
                    </span>
                  </div>
                  <div class="o_kanban_record_body">
                    <div class="text-muted small">
                      <i class="fa fa-user me-1"/><t t-esc="record.attendant_id.value"/>
                    </div>
                    <div class="fw-bold mt-1">
                      <field name="total_sales" widget="monetary"/>
                    </div>
                    <div class="text-muted small mt-1">
                      <i class="fa fa-credit-card me-1"/>
                      <t t-esc="record.credit_sale_count.raw_value"/> credit sales
                    </div>
                  </div>
                  <div class="o_kanban_record_bottom mt-2">
                    <div class="oe_kanban_bottom_left text-muted small">
                      <field name="date"/>
                    </div>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- ================================================================
         Form View
    ================================================================ -->
    <record id="view_fuel_attendant_session_form" model="ir.ui.view">
      <field name="name">fuel.attendant.session.form</field>
      <field name="model">fuel.attendant.session</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_populate_shift_transactions" type="object"
                    string="Pull Shift Transactions" class="btn-secondary"
                    invisible="state != 'draft'"/>
            <button name="action_approve" type="object" string="Approve"
                    class="btn-primary" invisible="state != 'draft'"
                    groups="fuel_station.group_fuel_manager"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_open_credit_sales" type="object"
                      class="oe_stat_button" icon="fa-credit-card">
                <field name="credit_sale_count" widget="statinfo" string="Credit Sales"/>
              </button>
              <button name="action_open_cash_deposits" type="object"
                      class="oe_stat_button" icon="fa-money">
                <field name="cash_deposit_count" widget="statinfo" string="Cash Deposits"/>
              </button>
            </div>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" readonly="1"/></h1>
            </div>
            <group>
              <group string="Session Details">
                <field name="date"/>
                <field name="shift_id"/>
                <field name="attendant_id"/>
              </group>
              <group string="Summary">
                <field name="currency_id" invisible="1"/>
                <field name="total_sales" widget="monetary" readonly="1"/>
                <field name="total_credit_sales" widget="monetary" readonly="1"/>
              </group>
            </group>
            <notebook>
              <page string="Sales" name="sales">
                <field name="line_ids">
                  <list editable="bottom">
                    <field name="nozzle_id" domain="[('active','=',True)]"/>
                    <field name="pump_id" readonly="1" optional="show"/>
                    <field name="product_id" readonly="1"/>
                    <field name="previous_meter" readonly="1"/>
                    <field name="current_meter"/>
                    <field name="litres_sold" readonly="1"/>
                    <field name="price"/>
                    <field name="total" readonly="1"/>
                  </list>
                </field>
                <group class="oe_subtotal_footer">
                  <field name="total_sales" widget="monetary" readonly="1"
                         string="Total Sales"/>
                </group>
              </page>
              <page string="Credit Sales" name="credit_sales">
                <field name="credit_sale_ids" readonly="1">
                  <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="invoice_ref"/>
                    <field name="nozzle_id"/>
                    <field name="pump_id" optional="show"/>
                    <field name="customer_id"/>
                    <field name="vehicle_plate"/>
                    <field name="litres"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="amount" widget="monetary"/>
                    <field name="payment_state" widget="badge"
                           decoration-danger="payment_state == 'unpaid'"
                           decoration-warning="payment_state == 'partial'"
                           decoration-success="payment_state == 'paid'"/>
                  </list>
                </field>
                <group class="oe_subtotal_footer">
                  <field name="total_credit_sales" widget="monetary" readonly="1"
                         string="Total Credit Sales"/>
                </group>
              </page>
              <page string="Cash" name="cash">
                <field name="cash_deposit_ids" readonly="1">
                  <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="amount" widget="monetary"/>
                    <field name="received_by_id"/>
                  </list>
                </field>
                <group string="Cash Reconciliation" class="oe_subtotal_footer">
                  <field name="expected_cash" widget="monetary" readonly="1"/>
                  <field name="total_cash_deposited" widget="monetary" readonly="1"/>
                  <field name="cash_difference" widget="monetary" readonly="1"/>
                </group>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <!-- ================================================================
         Search View
    ================================================================ -->
    <record id="view_fuel_attendant_session_search" model="ir.ui.view">
      <field name="name">fuel.attendant.session.search</field>
      <field name="model">fuel.attendant.session</field>
      <field name="arch" type="xml">
        <search string="Search Sessions">
          <field name="name"/>
          <field name="attendant_id"/>
          <field name="shift_id"/>
          <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
          <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
          <separator/>
          <filter string="Today" name="today"
                  domain="[('date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),('date','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
          <filter string="This Month" name="this_month"
                  domain="[('date','&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d'))]"/>
          <group>
            <filter string="Attendant" name="group_attendant" context="{'group_by': 'attendant_id'}"/>
            <filter string="Shift" name="group_shift" context="{'group_by': 'shift_id'}"/>
            <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
            <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ================================================================
         Action
    ================================================================ -->
    <record id="action_fuel_attendant_sessions" model="ir.actions.act_window">
      <field name="name">Attendant Sessions</field>
      <field name="res_model">fuel.attendant.session</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="search_view_id" ref="view_fuel_attendant_session_search"/>
      <field name="context">{"search_default_today": 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          No attendant sessions recorded yet.
        </p>
        <p>Create a session for each attendant to track their pump readings, credit sales, and cash handovers.</p>
      </field>
    </record>

  </data>
</odoo>
