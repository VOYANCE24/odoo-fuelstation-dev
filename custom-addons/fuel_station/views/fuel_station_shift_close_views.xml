<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- ================================================================
         List View
    ================================================================ -->
    <record id="view_fuel_station_shift_close_tree" model="ir.ui.view">
      <field name="name">fuel.station.shift.close.tree</field>
      <field name="model">fuel.station.shift.close</field>
      <field name="arch" type="xml">
        <list decoration-muted="state == 'draft'"
              decoration-success="state == 'approved'">
          <field name="name"/>
          <field name="date"/>
          <field name="shift_id"/>
          <field name="currency_id" column_invisible="1"/>
          <field name="pump_sales_total" widget="monetary"/>
          <field name="pump_credit_total" widget="monetary" optional="show"/>
          <field name="cash_expected" widget="monetary" optional="show"/>
          <field name="cash_deposited_in_safe" widget="monetary" optional="show"/>
          <field name="safe_difference" widget="monetary" optional="hide"/>
          <field name="state" widget="badge"
                 decoration-success="state == 'approved'"/>
        </list>
      </field>
    </record>

    <!-- ================================================================
         Form View
    ================================================================ -->
    <record id="view_fuel_station_shift_close_form" model="ir.ui.view">
      <field name="name">fuel.station.shift.close.form</field>
      <field name="model">fuel.station.shift.close</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_prepare_shift_close" type="object"
                    string="Prepare Shift Close" class="btn-secondary"
                    invisible="state != 'draft'"
                    groups="fuel_station.group_fuel_manager"
                    help="Pulls approved sessions, creates fuel balance lines (with auto-carried opening stock), and links credit payments — all in one step."/>
            <button name="action_approve" type="object" string="Approve"
                    class="btn-primary" invisible="state != 'draft'"
                    groups="fuel_station.group_fuel_manager"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_open_sessions" type="object"
                      class="oe_stat_button" icon="fa-users">
                <field name="session_count" widget="statinfo" string="Sessions"/>
              </button>
              <button name="action_open_credit_payments" type="object"
                      class="oe_stat_button" icon="fa-credit-card">
                <field name="credit_payment_count" widget="statinfo" string="Credit Payments"/>
              </button>
              <button name="action_view_safe_deposit_entry" type="object"
                      class="oe_stat_button" icon="fa-university"
                      invisible="not move_id">
                <div class="o_field_widget o_stat_info">
                  <span class="o_stat_text">Safe Deposit Entry</span>
                </div>
              </button>
            </div>
            <field name="move_id" invisible="1"/>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" readonly="1"/></h1>
            </div>
            <group>
              <group string="Shift Details">
                <field name="date"/>
                <field name="shift_id"/>
              </group>
              <group string="Cash Summary">
                <field name="currency_id" invisible="1"/>
                <field name="pump_sales_total" widget="monetary" readonly="1" string="Total Cash Sales"/>
                <field name="payout_total" widget="monetary" readonly="1"/>
                <field name="cash_expected" widget="monetary" readonly="1"/>
                <field name="cash_deposited_in_safe" widget="monetary"/>
                <field name="safe_difference" widget="monetary" readonly="1"/>
              </group>
            </group>
            <field name="note" placeholder="Notes…" readonly="state == 'approved'"/>
            <notebook>
              <page string="Sessions" name="sessions">
                <field name="attendant_session_ids" readonly="1">
                  <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="attendant_id"/>
                    <field name="shift_id"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="total_sales" widget="monetary"/>
                    <field name="total_credit_sales" widget="monetary" optional="show"/>
                    <field name="total_cash_deposited" widget="monetary" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'approved'"/>
                  </list>
                </field>
              </page>
              <page string="Litre Balancing" name="litre_balancing">
                <field name="fuel_balance_line_ids">
                  <list editable="bottom">
                    <field name="product_id"/>
                    <field name="uom_id" readonly="1" options="{'no_open': true}" string="Unit"/>
                    <field name="opening_litres"/>
                    <field name="delivered_litres" readonly="1"/>
                    <field name="closing_litres"/>
                    <field name="pump_sold_litres" readonly="1"/>
                    <field name="expected_outflow" readonly="1"/>
                    <field name="litre_difference" readonly="1"/>
                    <field name="price"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="loss_value" widget="monetary" readonly="1"/>
                  </list>
                </field>
              </page>
              <page string="Credit Payments" name="credit_payments">
                <field name="credit_payment_ids" readonly="1">
                  <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="invoice_ref"/>
                    <field name="customer_id"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="amount_paid" widget="monetary"/>
                    <field name="payment_method" widget="badge"
                           decoration-success="payment_method == 'cash'"
                           decoration-info="payment_method == 'cheque'"/>
                  </list>
                </field>
              </page>
              <page string="Cash Expenses" name="cash_expenses">
                <field name="expense_ids" readonly="1">
                  <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="vendor_id" optional="show"/>
                    <field name="receipt_ref" optional="show"/>
                    <field name="paid_by" optional="show"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="amount" widget="monetary"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'posted'"
                           decoration-warning="state == 'draft'"/>
                  </list>
                </field>
                <group class="oe_subtotal_footer">
                  <field name="total_expenses" widget="monetary" readonly="1"
                         string="Total Cash Expenses"/>
                </group>
              </page>
              <page string="Cash Balancing" name="cash_balancing">
                <group string="Sales Summary">
                  <field name="pump_sales_total" widget="monetary" readonly="1"
                         string="Total Cash Sales"/>
                  <field name="pump_credit_total" widget="monetary" readonly="1"/>
                </group>
                <group string="Credit Payment Collections">
                  <field name="cash_credit_payments" widget="monetary" readonly="1"/>
                  <field name="cheque_credit_payments" widget="monetary" readonly="1"/>
                </group>
                <group string="Cash Reconciliation" class="oe_subtotal_footer">
                  <field name="cash_expected" widget="monetary" readonly="1"/>
                  <field name="total_expenses" widget="monetary" readonly="1"/>
                  <field name="cash_deposited_in_safe" widget="monetary"/>
                  <field name="safe_difference" widget="monetary" readonly="1"/>
                </group>
              </page>
            </notebook>
          </sheet>

        </form>
      </field>
    </record>

    <!-- ================================================================
         Search View
    ================================================================ -->
    <record id="view_fuel_station_shift_close_search" model="ir.ui.view">
      <field name="name">fuel.station.shift.close.search</field>
      <field name="model">fuel.station.shift.close</field>
      <field name="arch" type="xml">
        <search string="Search Shift Closes">
          <field name="name"/>
          <field name="shift_id"/>
          <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
          <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
          <separator/>
          <filter string="Today" name="today"
                  domain="[('date','=', context_today().strftime('%Y-%m-%d'))]"/>
          <filter string="This Month" name="this_month"
                  domain="[('date','&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d'))]"/>
          <group>
            <filter string="Shift" name="group_shift" context="{'group_by': 'shift_id'}"/>
            <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
            <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ================================================================
         Action
    ================================================================ -->
    <record id="action_fuel_station_shift_closes" model="ir.actions.act_window">
      <field name="name">Station Shift Close</field>
      <field name="res_model">fuel.station.shift.close</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_fuel_station_shift_close_search"/>
      <field name="context">{"search_default_today": 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          No shift close records yet.
        </p>
        <p>Create a shift close to consolidate all attendant sessions, fuel balance, and cash reconciliation for a shift.</p>
      </field>
    </record>

  </data>
</odoo>
