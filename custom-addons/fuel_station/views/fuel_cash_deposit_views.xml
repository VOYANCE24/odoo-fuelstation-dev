<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_fuel_cash_deposit_tree" model="ir.ui.view">
      <field name="name">fuel.cash.deposit.tree</field>
      <field name="model">fuel.cash.deposit</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="date"/>
          <field name="shift_id"/>
          <field name="attendant_id"/>
          <field name="amount"/>
          <field name="received_by_id"/>
        </tree>
      </field>
    </record>

    <record id="view_fuel_cash_deposit_form" model="ir.ui.view">
      <field name="name">fuel.cash.deposit.form</field>
      <field name="model">fuel.cash.deposit</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name" readonly="1"/>
              <field name="date"/>
              <field name="shift_id"/>
              <field name="attendant_id"/>
            </group>
            <group>
              <field name="amount"/>
              <field name="received_by_id"/>
              <field name="note"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_fuel_cash_deposits" model="ir.actions.act_window">
      <field name="name">Cash Deposits</field>
      <field name="res_model">fuel.cash.deposit</field>
      <field name="view_mode">tree,form</field>
    </record>

  </data>
</odoo>