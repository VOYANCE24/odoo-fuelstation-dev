<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_fuel_credit_payment_tree" model="ir.ui.view">
      <field name="name">fuel.credit.payment.tree</field>
      <field name="model">fuel.credit.payment</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="date"/>
          <field name="shift_id"/>
          <field name="invoice_ref"/>
          <field name="customer_id"/>
          <field name="currency_id" column_invisible="1"/>
          <field name="amount_paid" widget="monetary"/>
          <field name="payment_method" widget="badge"
                 decoration-success="payment_method == 'cash'"
                 decoration-info="payment_method == 'cheque'"/>
          <field name="receipt_no" optional="hide"/>
        </list>
      </field>
    </record>

    <record id="view_fuel_credit_payment_form" model="ir.ui.view">
      <field name="name">fuel.credit.payment.form</field>
      <field name="model">fuel.credit.payment</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" readonly="1"/></h1>
            </div>
            <group>
              <group string="Payment Details">
                <field name="date"/>
                <field name="shift_id"/>
                <field name="receipt_no" placeholder="Receipt number"/>
                <field name="payment_method"/>
              </group>
              <group string="Credit Reference">
                <field name="invoice_ref"/>
                <field name="credit_sale_id"
                       help="Link to the originating credit sale to track its outstanding balance."/>
                <field name="customer_id"/>
                <field name="currency_id" invisible="1"/>
                <field name="total_balance" widget="monetary" string="Outstanding Balance"/>
                <field name="amount_paid" widget="monetary"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_fuel_credit_payment_search" model="ir.ui.view">
      <field name="name">fuel.credit.payment.search</field>
      <field name="model">fuel.credit.payment</field>
      <field name="arch" type="xml">
        <search string="Search Credit Payments">
          <field name="name"/>
          <field name="invoice_ref"/>
          <field name="customer_id"/>
          <field name="shift_id"/>
          <filter string="Cash" name="cash" domain="[('payment_method','=','cash')]"/>
          <filter string="Cheque" name="cheque" domain="[('payment_method','=','cheque')]"/>
          <separator/>
          <filter string="Today" name="today"
                  domain="[('date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),('date','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
          <filter string="This Month" name="this_month"
                  domain="[('date','&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d'))]"/>
          <separator/>
          <filter string="Not Linked to Shift Close" name="unlinked"
                  domain="[('station_close_id','=',False)]"/>
          <group>
            <filter string="Payment Method" name="group_method" context="{'group_by': 'payment_method'}"/>
            <filter string="Shift" name="group_shift" context="{'group_by': 'shift_id'}"/>
            <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
            <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="action_fuel_credit_payments" model="ir.actions.act_window">
      <field name="name">Credit Payments</field>
      <field name="res_model">fuel.credit.payment</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_fuel_credit_payment_search"/>
      <field name="context">{"search_default_today": 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          No credit payments recorded yet.
        </p>
        <p>Record payments received from customers settling their credit balances.</p>
      </field>
    </record>

  </data>
</odoo>
