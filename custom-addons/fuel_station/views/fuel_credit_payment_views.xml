<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_fuel_credit_payment_tree" model="ir.ui.view">
      <field name="name">fuel.credit.payment.tree</field>
      <field name="model">fuel.credit.payment</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="date"/>
          <field name="shift_id"/>
          <field name="invoice_ref"/>
          <field name="customer_id"/>
          <field name="amount_paid"/>
          <field name="payment_method"/>
        </list>
      </field>
    </record>

    <record id="view_fuel_credit_payment_form" model="ir.ui.view">
      <field name="name">fuel.credit.payment.form</field>
      <field name="model">fuel.credit.payment</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name" readonly="1"/>
              <field name="date"/>
              <field name="shift_id"/>
              <field name="receipt_no"/>
            </group>
            <group>
              <field name="invoice_ref"/>
              <field name="customer_id"/>
              <field name="total_balance"/>
              <field name="amount_paid"/>
              <field name="payment_method"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_fuel_credit_payments" model="ir.actions.act_window">
      <field name="name">Credit Payments</field>
      <field name="res_model">fuel.credit.payment</field>
      <field name="view_mode">list,form</field>
    </record>

  </data>
</odoo>