<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- ================================================================
         List View
    ================================================================ -->
    <record id="view_fuel_credit_sale_tree" model="ir.ui.view">
      <field name="name">fuel.credit.sale.tree</field>
      <field name="model">fuel.credit.sale</field>
      <field name="arch" type="xml">
        <list decoration-danger="payment_state == 'unpaid'"
              decoration-warning="payment_state == 'partial'"
              decoration-success="payment_state == 'paid'">
          <field name="name"/>
          <field name="date"/>
          <field name="shift_id"/>
          <field name="attendant_id"/>
          <field name="pump_id"/>
          <field name="product_id" optional="show"/>
          <field name="invoice_ref"/>
          <field name="customer_id"/>
          <field name="vehicle_plate" optional="show"/>
          <field name="vehicle_type" optional="hide"/>
          <field name="litres"/>
          <field name="currency_id" column_invisible="1"/>
          <field name="amount" widget="monetary"/>
          <field name="amount_paid" widget="monetary" optional="show"/>
          <field name="amount_outstanding" widget="monetary" optional="show"/>
          <field name="payment_state" widget="badge"
                 decoration-danger="payment_state == 'unpaid'"
                 decoration-warning="payment_state == 'partial'"
                 decoration-success="payment_state == 'paid'"/>
        </list>
      </field>
    </record>

    <!-- ================================================================
         Kanban View
    ================================================================ -->
    <record id="view_fuel_credit_sale_kanban" model="ir.ui.view">
      <field name="name">fuel.credit.sale.kanban</field>
      <field name="model">fuel.credit.sale</field>
      <field name="arch" type="xml">
        <kanban default_group_by="payment_state" class="o_kanban_small_column"
                quick_create="false">
          <field name="name"/>
          <field name="customer_id"/>
          <field name="invoice_ref"/>
          <field name="amount"/>
          <field name="amount_outstanding"/>
          <field name="payment_state"/>
          <field name="currency_id"/>
          <field name="attendant_id"/>
          <field name="date"/>
          <templates>
            <t t-name="card">
              <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                <div class="oe_kanban_content p-3">
                  <div class="o_kanban_record_top mb-2">
                    <div class="o_kanban_record_headings">
                      <strong class="o_kanban_record_title fs-6">
                        <t t-esc="record.invoice_ref.value"/>
                      </strong>
                    </div>
                    <span t-attf-class="badge rounded-pill #{record.payment_state.raw_value == 'paid' ? 'text-bg-success' : record.payment_state.raw_value == 'partial' ? 'text-bg-warning' : 'text-bg-danger'}">
                      <field name="payment_state"/>
                    </span>
                  </div>
                  <div class="o_kanban_record_body">
                    <div class="text-muted small">
                      <i class="fa fa-user me-1"/><t t-esc="record.customer_id.value or record.attendant_id.value"/>
                    </div>
                    <div class="fw-bold mt-1">
                      <field name="amount" widget="monetary"/>
                    </div>
                    <t t-if="record.amount_outstanding.raw_value > 0">
                      <div class="text-danger small">
                        Outstanding: <field name="amount_outstanding" widget="monetary"/>
                      </div>
                    </t>
                  </div>
                  <div class="o_kanban_record_bottom mt-2">
                    <div class="oe_kanban_bottom_left text-muted small">
                      <field name="date"/>
                    </div>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- ================================================================
         Form View
    ================================================================ -->
    <record id="view_fuel_credit_sale_form" model="ir.ui.view">
      <field name="name">fuel.credit.sale.form</field>
      <field name="model">fuel.credit.sale</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <field name="payment_state" widget="statusbar"
                   statusbar_visible="unpaid,partial,paid"/>
          </header>
          <sheet>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" readonly="1"/></h1>
            </div>
            <group>
              <group string="Sale Details">
                <field name="date"/>
                <field name="shift_id"/>
                <field name="attendant_id"/>
                <field name="pump_id"/>
                <field name="product_id" readonly="1"/>
              </group>
              <group string="Customer / Vehicle">
                <field name="invoice_ref"/>
                <field name="customer_id"/>
                <field name="customer_name" placeholder="Name if not in system"/>
                <field name="vehicle_type" optional="hide"/>
                <field name="vehicle_plate"/>
              </group>
            </group>
            <group>
              <group string="Fuel">
                <field name="litres"/>
                <field name="price"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount" widget="monetary" readonly="1"/>
              </group>
              <group string="Payment Status">
                <field name="amount_paid" widget="monetary" readonly="1"/>
                <field name="amount_outstanding" widget="monetary" readonly="1"/>
              </group>
            </group>
            <notebook>
              <page string="Payment History" name="payments">
                <field name="payment_ids" readonly="1">
                  <list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="receipt_no"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="amount_paid" widget="monetary"/>
                    <field name="payment_method" widget="badge"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>

    <!-- ================================================================
         Search View
    ================================================================ -->
    <record id="view_fuel_credit_sale_search" model="ir.ui.view">
      <field name="name">fuel.credit.sale.search</field>
      <field name="model">fuel.credit.sale</field>
      <field name="arch" type="xml">
        <search string="Search Credit Sales">
          <field name="name"/>
          <field name="invoice_ref"/>
          <field name="customer_id"/>
          <field name="vehicle_plate"/>
          <field name="attendant_id"/>
          <field name="shift_id"/>
          <filter string="Unpaid" name="unpaid" domain="[('payment_state','=','unpaid')]"/>
          <filter string="Partial" name="partial" domain="[('payment_state','=','partial')]"/>
          <filter string="Paid" name="paid" domain="[('payment_state','=','paid')]"/>
          <separator/>
          <filter string="Today" name="today"
                  domain="[('date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),('date','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
          <filter string="This Month" name="this_month"
                  domain="[('date','&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d'))]"/>
          <separator/>
          <filter string="Not Linked to Session" name="unlinked_session"
                  domain="[('session_id','=',False)]"/>
          <group>
            <filter string="Payment Status" name="group_payment_state" context="{'group_by': 'payment_state'}"/>
            <filter string="Attendant" name="group_attendant" context="{'group_by': 'attendant_id'}"/>
            <filter string="Shift" name="group_shift" context="{'group_by': 'shift_id'}"/>
            <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
            <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ================================================================
         Action
    ================================================================ -->
    <record id="action_fuel_credit_sales" model="ir.actions.act_window">
      <field name="name">Credit Sales</field>
      <field name="res_model">fuel.credit.sale</field>
      <field name="view_mode">list,kanban,form</field>
      <field name="search_view_id" ref="view_fuel_credit_sale_search"/>
      <field name="context">{"search_default_today": 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          No credit sales recorded yet.
        </p>
        <p>Record a credit sale when a customer takes fuel on credit during a shift.</p>
      </field>
    </record>

  </data>
</odoo>
