<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- =========================
             Calibration Profile: List
             ========================= -->
        <record id="view_fuel_calibration_profile_list" model="ir.ui.view">
            <field name="name">fuel.calibration.profile.list</field>
            <field name="model">fuel.calibration.profile</field>
            <field name="arch" type="xml">
                <list string="Calibration Profiles">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="active"/>
                    <field name="write_date"/>
                </list>
            </field>
        </record>

        <!-- =========================
             Calibration Profile: Form
             ========================= -->
        <record id="view_fuel_calibration_profile_form" model="ir.ui.view">
            <field name="name">fuel.calibration.profile.form</field>
            <field name="model">fuel.calibration.profile</field>
            <field name="arch" type="xml">
                <form string="Calibration Profile">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="active"/>
                        </group>

                        <notebook>
                            <page string="Calibration Lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="depth_mm"/>
                                        <field name="volume_liters"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- =========================
             Calibration Profile: Search
             ========================= -->
        <record id="view_fuel_calibration_profile_search" model="ir.ui.view">
            <field name="name">fuel.calibration.profile.search</field>
            <field name="model">fuel.calibration.profile</field>
            <field name="arch" type="xml">
                <search string="Search Calibration Profiles">
                    <field name="name"/>
                    <field name="product_id"/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>

        <!-- =========================
             Action
             ========================= -->
        <record id="action_fuel_calibration_profiles" model="ir.actions.act_window">
            <field name="name">Calibration Profiles</field>
            <field name="res_model">fuel.calibration.profile</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_fuel_calibration_profile_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a calibration profile to map tank dip depth to volume.
                </p>
            </field>
        </record>

        <!-- =========================
             Menus
             ========================= -->
        <menuitem id="menu_fuel_station_root" name="Fuel Station" sequence="10"/>

        <menuitem id="menu_fuel_station_configuration"
                  name="Configuration"
                  parent="menu_fuel_station_root"
                  sequence="20"/>

        <menuitem id="menu_fuel_calibration_profiles"
                  name="Calibration Profiles"
                  parent="menu_fuel_station_configuration"
                  action="action_fuel_calibration_profiles"
                  sequence="10"/>

    </data>
</odoo>