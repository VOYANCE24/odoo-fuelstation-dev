<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_fuel_delivery_list" model="ir.ui.view">
        <field name="name">fuel.delivery.list</field>
        <field name="model">fuel.delivery</field>
        <field name="arch" type="xml">
            <list string="Fuel Deliveries">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="truck_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_fuel_delivery_form" model="ir.ui.view">
        <field name="name">fuel.delivery.form</field>
        <field name="model">fuel.delivery</field>
        <field name="arch" type="xml">
            <form string="Fuel Delivery">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,measured,applied"/>
                    <button name="action_mark_measured" type="object" string="Mark Measured"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_apply_measured_quantities" type="object" string="Apply to Stock"
                            class="btn-primary" invisible="state != 'measured'"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="picking_id"/>
                        </group>
                        <group>
                            <field name="truck_id"/>
                            <field name="notes"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Compartments">
                            <!-- IMPORTANT: no active_id in context -->
                            <field name="compartment_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="compartment_code"/>
                                    <field name="product_id"/>
                                    <field name="expected_depth_mm"/>
                                    <field name="measured_depth_mm"/>
                                    <field name="depth_diff_mm" readonly="1"/>
                                    <field name="expected_density"/>
                                    <field name="measured_density"/>
                                    <field name="density_diff" readonly="1"/>
                                    <field name="calibration_profile_id"/>
                                    <field name="measured_volume_liters" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Tank Dips">
                            <!-- IMPORTANT: no active_id in context -->
                            <field name="tankdip_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="tank_code"/>
                                    <field name="product_id"/>
                                    <field name="calibration_profile_id"/>
                                    <field name="depth_before_mm"/>
                                    <field name="depth_after_mm"/>
                                    <field name="volume_before_liters" readonly="1"/>
                                    <field name="volume_after_liters" readonly="1"/>
                                    <field name="delta_volume_liters" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_fuel_delivery" model="ir.actions.act_window">
        <field name="name">Fuel Deliveries</field>
        <field name="res_model">fuel.delivery</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_fuel_station_root" name="Fuel Station" sequence="50"/>
    <menuitem id="menu_fuel_delivery" name="Fuel Deliveries" parent="menu_fuel_station_root"
              action="action_fuel_delivery" sequence="10"/>

</odoo>