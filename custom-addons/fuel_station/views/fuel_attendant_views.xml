<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_fuel_attendant_tree" model="ir.ui.view">
      <field name="name">fuel.attendant.tree</field>
      <field name="model">fuel.attendant</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="employee_id" optional="show"/>
          <field name="partner_id" optional="show"/>
          <field name="active" optional="hide"/>
        </list>
      </field>
    </record>

    <record id="view_fuel_attendant_form" model="ir.ui.view">
      <field name="name">fuel.attendant.form</field>
      <field name="model">fuel.attendant</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_view_shortage_invoices" type="object"
                      class="oe_stat_button" icon="fa-exclamation-circle"
                      invisible="shortage_invoice_count == 0">
                <div class="o_field_widget o_stat_info">
                  <span class="o_stat_value">
                    <field name="shortage_invoice_count"/>
                  </span>
                  <span class="o_stat_text">Shortages</span>
                </div>
              </button>
            </div>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" placeholder="Attendant Name"/></h1>
            </div>
            <group>
              <group string="Details">
                <field name="employee_id"/>
                <field name="partner_id"
                       help="Required for shortage invoices when a session has a cash shortage."/>
                <field name="active"/>
              </group>
              <group string="Outstanding Shortages" invisible="shortage_invoice_count == 0">
                <field name="currency_id" invisible="1"/>
                <field name="total_outstanding_shortage" widget="monetary"
                       string="Total Owed to Station"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_fuel_attendant_search" model="ir.ui.view">
      <field name="name">fuel.attendant.search</field>
      <field name="model">fuel.attendant</field>
      <field name="arch" type="xml">
        <search string="Search Attendants">
          <field name="name"/>
          <field name="employee_id"/>
          <filter string="Active" name="active" domain="[('active','=',True)]"/>
          <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
        </search>
      </field>
    </record>

    <record id="action_fuel_attendants" model="ir.actions.act_window">
      <field name="name">Pump Attendants</field>
      <field name="res_model">fuel.attendant</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_fuel_attendant_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Add your first pump attendant.
        </p>
        <p>Attendants are linked to attendant sessions and credit sales.</p>
      </field>
    </record>

  </data>
</odoo>
