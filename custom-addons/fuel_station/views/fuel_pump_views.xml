<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_fuel_pump_tree" model="ir.ui.view">
      <field name="name">fuel.pump.tree</field>
      <field name="model">fuel.pump</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="code" optional="hide"/>
          <field name="product_id"/>
          <field name="active" optional="hide"/>
        </list>
      </field>
    </record>

    <record id="view_fuel_pump_form" model="ir.ui.view">
      <field name="name">fuel.pump.form</field>
      <field name="model">fuel.pump</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" placeholder="e.g. Pump 1"/></h1>
            </div>
            <group>
              <field name="code" placeholder="e.g. P1"/>
              <field name="product_id"/>
              <field name="active"/>
            </group>
            <notebook>
              <page string="Nozzles" name="nozzles">
                <field name="nozzle_ids">
                  <list editable="bottom">
                    <field name="nozzle_number" string="Nozzle #"/>
                    <field name="name"/>
                    <field name="active" optional="hide"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_fuel_pump_search" model="ir.ui.view">
      <field name="name">fuel.pump.search</field>
      <field name="model">fuel.pump</field>
      <field name="arch" type="xml">
        <search string="Search Pumps">
          <field name="name"/>
          <field name="product_id"/>
          <filter string="Active" name="active" domain="[('active','=',True)]"/>
          <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
          <group>
            <filter string="Fuel Product" name="group_product" context="{'group_by': 'product_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="action_fuel_pumps" model="ir.actions.act_window">
      <field name="name">Pumps</field>
      <field name="res_model">fuel.pump</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_fuel_pump_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Register your first fuel pump.
        </p>
        <p>Each pump is assigned a fuel product and used to track meter readings per attendant session.</p>
      </field>
    </record>

  </data>
</odoo>
