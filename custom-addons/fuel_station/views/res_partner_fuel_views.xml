<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Inherit the standard partner form to add fuel credit limit -->
    <record id="view_res_partner_fuel_form_inherit" model="ir.ui.view">
      <field name="name">res.partner.fuel.form.inherit</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='sales_purchases']" position="after">
          <page string="Fuel Credit" name="fuel_credit"
                groups="fuel_station.group_fuel_manager">
            <group string="Credit Settings">
              <field name="fuel_credit_limit"
                     help="Set to 0.00 to allow unlimited credit for this customer."/>
            </group>
          </page>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
